root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{d,di}]
indent_size = 2
tab_width = 2
max_line_length = 80
dfmt_soft_max_line_length = 80
dfmt_brace_style = otbs
dfmt_align_switch_statements = true
dfmt_outdent_attributes = true
dfmt_space_after_cast = false
dfmt_space_before_function_parameters = false
dfmt_selective_import_space = true
dfmt_compact_labeled_statements = true
dfmt_split_operator_at_line_end = true
dfmt_single_template_constraint_indent = false
dfmt_template_constraint_style = conditional_newline_indent

[*.{c,cc,cpp,h,hpp,mm,proto}]
indent_size = 2
max_line_length = 80

[*.java]
indent_size = 2
max_line_length = 100

[{BUILD,BUILD.bazel,MODULE.bazel,*.bzl}]
indent_size = 4
