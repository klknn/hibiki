namespace hibiki.ipc;

table LoadPlugin {
    track_index: int;
    path: string;
    plugin_index: int = 0;
}

table LoadClip {
    track_index: int;
    slot_index: int;
    path: string;
    is_loop: bool = false;
}

table SetClipLoop {
    track_index: int;
    slot_index: int;
    is_loop: bool;
}

table Play {}

table Stop {}

table PlayClip {
    track_index: int;
    slot_index: int;
}

table StopTrack {
    track_index: int;
}

table ShowPluginGui {
    track_index: int;
    plugin_index: int;
}

table SetParamValue {
    track_index: int;
    plugin_index: int;
    param_id: uint;
    value: float;
}

table RemovePlugin {
    track_index: int;
    plugin_index: int;
}

table SaveProject {
    path: string;
}

table LoadProject {
    path: string;
}

table SetBpm {
    bpm: float;
}

table PlayScene {
    slot_index: int;
}

table DeleteClip {
    track_index: int;
    slot_index: int;
}

table Quit {}

table ListPlugins {
    path: string;
}

table BounceProject {
    path: string;
}

union Command {
    LoadPlugin,
    LoadClip,
    Play,
    Stop,
    PlayClip,
    StopTrack,
    ShowPluginGui,
    SetParamValue,
    RemovePlugin,
    SaveProject,
    LoadProject,
    SetClipLoop,
    SetBpm,
    PlayScene,
    DeleteClip,
    Quit,
    ListPlugins,
    Undo,
    Redo,
    AddTimelineClip,
    RemoveTimelineClip,
    Seek,
    BounceProject,
    GetClipMidi,
    UpdateClipMidi
}

// Request MIDI data for a clip (for Piano Roll editing)
// Use slot_index >= 0 for session clips, clip_index >= 0 for timeline clips
table GetClipMidi {
    track_index: int;
    slot_index: int = -1;   // Session clip slot (-1 = use clip_index instead)
    clip_index: int = -1;   // Timeline clip index (-1 = use slot_index instead)
}

// MIDI event for update
table UpdateMidiEvent {
    tick: long;
    pitch: int;
    duration_ticks: long;
    velocity: int;
}

// Update clip's MIDI data (from Piano Roll edits)
// Use slot_index >= 0 for session clips, clip_index >= 0 for timeline clips
table UpdateClipMidi {
    track_index: int;
    slot_index: int = -1;   // Session clip slot (-1 = use clip_index instead)
    clip_index: int = -1;   // Timeline clip index (-1 = use slot_index instead)
    resolution: int;
    events: [UpdateMidiEvent];
}

table AddTimelineClip {
    track_index: int;
    path: string;
    start_time: float;
}

table RemoveTimelineClip {
    track_index: int;
    clip_index: int;
}

table Seek {
    position: float;
}

table Undo {}
table Redo {}

table Request {
    command: Command;
}

root_type Request;
