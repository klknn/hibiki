build --copt=-fno-asynchronous-unwind-tables
build --copt=-fno-unwind-tables
build --copt=-fno-exceptions
build --cxxopt=-fno-asynchronous-unwind-tables
build --cxxopt=-fno-unwind-tables
build --cxxopt=-fno-exceptions
build --cxxopt=-std=c++23
build:windows --cxxopt=/std:c++latest
build:windows --cxxopt=/utf-8
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --action_env=ANDROID_HOME
build --repo_env=ANDROID_HOME

# RECOMMENDATION: Pin the lockfile mode to 'error' to prevent silent changes across machines.
# If you intentionally change MODULE.bazel, run 'bazel mod deps' to update the lockfile.
# common --lockfile_mode=error