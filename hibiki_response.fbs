namespace hibiki.ipc;

table ParamInfo {
    id: uint;
    name: string;
    default_value: float;
}

table ParamList {
    track_index: int;
    plugin_index: int;
    plugin_name: string;
    is_instrument: bool;
    params: [ParamInfo];
}

table Log {
    message: string;
}

table Acknowledge {
    command_type: string;
    success: bool;
}

table ClipInfo {
    track_index: int;
    slot_index: int;
    name: string;
    path: string;
}

table ClearProject {}

table TrackLevel {
    track_index: int;
    peak_l: float;
    peak_r: float;
}

table TrackLevels {
    levels: [TrackLevel];
}

table ClipWaveform {
    track_index: int;
    slot_index: int;
    waveform: [float];
}

table PluginDescription {
    index: int;
    name: string;
    vendor: string;
}

table PluginList {
    path: string;
    plugins: [PluginDescription];
}

table TimelineClipInfo {
    track_index: int;
    clip_index: int;
    name: string;
    path: string;
    start_time: float;
    duration: float;
    waveform: [float];
}

table PlayheadInfo {
    position_sec: float;
    bpm: float;
    is_playing: bool;
}

table TrackInfo {
    track_index: int;
    name: string;
}

table BounceFinished {
    path: string;
    success: bool;
}

// MIDI note event for Piano Roll editing
table MidiEventData {
    tick: long;
    pitch: int;
    duration_ticks: long;
    velocity: int;
}

// Response containing clip's MIDI data for editing
// slot_index >= 0 for session clips, clip_index >= 0 for timeline clips
table ClipMidiData {
    track_index: int;
    slot_index: int = -1;   // Session clip slot
    clip_index: int = -1;   // Timeline clip index
    resolution: int;  // Ticks per quarter note
    events: [MidiEventData];
}

// Automation control point (reused from request schema via include or duplicated here)
table AutomationPointInfo {
    time_beats: float;
    value: float;
    tension: float;
}

table AutomationLaneInfo {
    track_index: int;
    lane_index: int;
    plugin_index: int;
    param_id: uint;
    param_name: string;
    points: [AutomationPointInfo];
}

table AutomationLanesData {
    track_index: int;
    lanes: [AutomationLaneInfo];
}

union Response {
    ParamList,
    Log,
    Acknowledge,
    ClipInfo,
    ClearProject,
    TrackLevels,
    ClipWaveform,
    PluginList,
    TimelineClipInfo,
    PlayheadInfo,
    BounceFinished,
    TrackInfo,
    ClipMidiData,
    AutomationLanesData
}

table Notification {
    response: Response;
}

root_type Notification;
